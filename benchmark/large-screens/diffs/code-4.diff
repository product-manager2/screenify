@@ -0,0 +1,87 @@
+import { ActivityList } from '@/activities/components/ActivityList';
+import { SkeletonLoader } from '@/activities/components/SkeletonLoader';
+import { TaskRow } from '@/activities/tasks/components/TaskRow';
+import { type Task } from '@/activities/types/Task';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { AnimatedPlaceholder } from '@/ui/feedback/empty-state/components/AnimatedPlaceholder/AnimatedPlaceholder';
+import { EmptyState } from '@/ui/feedback/empty-state/components/EmptyState';
+import { useLingui } from '@lingui/react/macro';
+import { useMemo } from 'react';
+import {
+  type RecordGqlOperationFilter,
+  StandardObjectNameSingular,
+} from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+
+const MY_WORK_OPEN_TASKS_LIMIT = 200;
+
+type MyWorkOpenTasksSectionProps = {
+  workspaceMemberId: string | undefined;
+};
+
+export const MyWorkOpenTasksSection = ({
+  workspaceMemberId,
+}: MyWorkOpenTasksSectionProps) => {
+  const { t } = useLingui();
+
+  const openTasksFilter: RecordGqlOperationFilter = useMemo(
+    () => ({
+      and: [
+        { assigneeId: { eq: workspaceMemberId ?? '' } },
+        { or: [{ status: { neq: 'DONE' } }, { status: { is: 'NULL' } }] },
+      ],
+    }),
+    [workspaceMemberId],
+  );
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: openTasksFilter,
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    skip: !isDefined(workspaceMemberId),
+    limit: MY_WORK_OPEN_TASKS_LIMIT,
+  });
+
+  const renderContent = () => {
+    if (loading && tasks.length === 0) {
+      return <SkeletonLoader />;
+    }
+
+    if (tasks.length === 0) {
+      return (
+        <EmptyState.Root>
+          <AnimatedPlaceholder type="noTask" />
+          <EmptyState.Content>
+            <EmptyState.Title>{t`No open tasks`}</EmptyState.Title>
+            <EmptyState.Description>
+              {t`All tasks assigned to you are done.`}
+            </EmptyState.Description>
+          </EmptyState.Content>
+        </EmptyState.Root>
+      );
+    }
+
+    return (
+      <ActivityList>
+        {tasks.map((task, index) => (
+          <TaskRow
+            key={task.id}
+            task={task}
+            divider={index < tasks.length - 1}
+          />
+        ))}
+      </ActivityList>
+    );
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that aren't done`}
+      />
+      {renderContent()}
+    </Section.Root>
+  );
+};
