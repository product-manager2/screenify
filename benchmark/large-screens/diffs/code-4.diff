+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { Section } from 'twenty-ui/components/layout';
+import { Text } from 'twenty-ui/primitives/typography';
+import { themeCssVariables } from 'twenty-ui/theme';
+
+import { dateLocaleState } from '@/localization/states/dateLocaleState';
+import { RecordChip } from '@/object-record/components/RecordChip';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { type Person } from '@/people/types/Person';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const MY_WORK_RECENT_PEOPLE_LIMIT = 5;
+
+const StyledPeopleList = styled.div`
+  display: flex;
+  flex-direction: column;
+  gap: ${themeCssVariables.spacing[2]};
+`;
+
+const StyledPersonRow = styled.div`
+  align-items: center;
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  justify-content: space-between;
+  min-width: 0;
+`;
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+  const { localeCatalog } = useAtomStateValue(dateLocaleState);
+
+  const { records: people } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: MY_WORK_RECENT_PEOPLE_LIMIT,
+  });
+
+  if (people.length === 0) {
+    return null;
+  }
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Recently added people`}
+        description={t`The latest people added to this workspace`}
+      />
+      <StyledPeopleList>
+        {people.map((person) => (
+          <StyledPersonRow key={person.id}>
+            <RecordChip
+              objectNameSingular={StandardObjectNameSingular.Person}
+              record={person}
+            />
+            <Text size="sm" color="light">
+              {t`Created ${beautifyPastDateRelativeToNow(person.createdAt, localeCatalog)}`}
+            </Text>
+          </StyledPersonRow>
+        ))}
+      </StyledPeopleList>
+    </Section.Root>
+  );
+};
