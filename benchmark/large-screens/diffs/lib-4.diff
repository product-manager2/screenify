new file mode 100644
index 00000000..33e2dc3a
--- /dev/null
+++ b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
@@ -0,0 +1,140 @@
+import { useMemo } from 'react';
+import { useLingui } from '@lingui/react/macro';
+import { SettingsPath } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconUsers } from 'twenty-ui/icon';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { ObjectMetadataIcon } from '@/object-metadata/components/ObjectMetadataIcon';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { StandardObjectNamePlural } from '@/object-metadata/types/StandardObjectNamePlural';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { Table } from '@/ui/layout/table/components/Table';
+import { TableBody } from '@/ui/layout/table/components/TableBody';
+import { TableCell } from '@/ui/layout/table/components/TableCell';
+import { TableHeader } from '@/ui/layout/table/components/TableHeader';
+import { TableRow } from '@/ui/layout/table/components/TableRow';
+import { styled } from '@linaria/react';
+
+const SETTINGS_USAGE_TABLE_GRID_TEMPLATE_COLUMNS = 'minmax(0, 1fr) 160px';
+
+const StyledNameCell = styled.div`
+  align-items: center;
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { formatNumber } = useNumberFormat();
+  const { activeNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+
+  const sortedObjectMetadataItems = useMemo(
+    () =>
+      [...activeNonSystemObjectMetadataItems].sort((itemA, itemB) =>
+        itemA.labelPlural.localeCompare(itemB.labelPlural),
+      ),
+    [activeNonSystemObjectMetadataItems],
+  );
+
+  const membersCount =
+    totalCountByObjectMetadataItemNamePlural[
+      StandardObjectNamePlural.WorkspaceMember
+    ];
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: t`Workspace`,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: t`Usage` },
+      ]}
+    >
+      <SettingsPageContainer>
+        <Section.Root>
+          <Section.Header title={t`Records`} />
+          <Table>
+            <TableRow
+              gridTemplateColumns={SETTINGS_USAGE_TABLE_GRID_TEMPLATE_COLUMNS}
+            >
+              <TableHeader>{t`Object`}</TableHeader>
+              <TableHeader align="right">{t`Count`}</TableHeader>
+            </TableRow>
+            <TableBody>
+              {sortedObjectMetadataItems.map((objectMetadataItem) => {
+                const objectCount =
+                  totalCountByObjectMetadataItemNamePlural[
+                    objectMetadataItem.namePlural
+                  ];
+
+                return (
+                  <TableRow
+                    key={objectMetadataItem.id}
+                    gridTemplateColumns={
+                      SETTINGS_USAGE_TABLE_GRID_TEMPLATE_COLUMNS
+                    }
+                  >
+                    <TableCell color={themeCssVariables.font.color.primary}>
+                      <StyledNameCell>
+                        <ObjectMetadataIcon
+                          objectMetadataItem={objectMetadataItem}
+                          size={theme.icon.size.md}
+                          stroke={theme.icon.stroke.sm}
+                        />
+                        <span>{objectMetadataItem.labelPlural}</span>
+                      </StyledNameCell>
+                    </TableCell>
+                    <TableCell
+                      align="right"
+                      color={themeCssVariables.font.color.secondary}
+                    >
+                      {isDefined(objectCount) ? formatNumber(objectCount) : ''}
+                    </TableCell>
+                  </TableRow>
+                );
+              })}
+            </TableBody>
+          </Table>
+        </Section.Root>
+        <Section.Root>
+          <Section.Header title={t`Members`} />
+          <Table>
+            <TableBody>
+              <TableRow
+                gridTemplateColumns={SETTINGS_USAGE_TABLE_GRID_TEMPLATE_COLUMNS}
+              >
+                <TableCell color={themeCssVariables.font.color.primary}>
+                  <StyledNameCell>
+                    <IconUsers
+                      size={theme.icon.size.md}
+                      stroke={theme.icon.stroke.sm}
+                    />
+                    <span>{t`Workspace members`}</span>
+                  </StyledNameCell>
+                </TableCell>
+                <TableCell
+                  align="right"
+                  color={themeCssVariables.font.color.secondary}
+                >
+                  {isDefined(membersCount) ? formatNumber(membersCount) : ''}
+                </TableCell>
+              </TableRow>
+            </TableBody>
+          </Table>
+        </Section.Root>
+      </SettingsPageContainer>
+    </SettingsPageLayout>
