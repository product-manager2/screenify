@@ -0,0 +1,119 @@
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { SkeletonLoader } from '@/activities/components/SkeletonLoader';
+import { type Person } from '@/people/types/Person';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { Section } from 'twenty-ui/components/layout';
+import { Avatar } from 'twenty-ui/primitives/data-display';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { getAbsoluteImageUrl } from '~/utils/image/getAbsoluteImageUrl';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+const StyledPersonInfo = styled.div`
+  align-items: center;
+  display: flex;
+  flex: 1;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+const StyledPersonName = styled.div`
+  color: ${themeCssVariables.font.color.primary};
+  font-weight: ${themeCssVariables.font.weight.medium};
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+`;
+
+const StyledCreatedAt = styled.div`
+  color: ${themeCssVariables.font.color.tertiary};
+  padding-left: ${themeCssVariables.spacing[2]};
+  white-space: nowrap;
+`;
+
+type MyWorkPersonRowProps = {
+  person: Person;
+  divider: boolean;
+};
+
+const MyWorkPersonRow = ({ person, divider }: MyWorkPersonRowProps) => {
+  const { t } = useLingui();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+
+  const fullName = [person.name.firstName, person.name.lastName]
+    .filter(isNonEmptyString)
+    .join(' ');
+  const label = isNonEmptyString(fullName) ? fullName : t`Unnamed person`;
+
+  return (
+    <ActivityRow
+      label={label}
+      divider={divider}
+      onClick={() => {
+        openRecordInSidePanel({
+          recordId: person.id,
+          objectNameSingular: StandardObjectNameSingular.Person,
+        });
+      }}
+    >
+      <StyledPersonInfo>
+        <Avatar
+          src={getAbsoluteImageUrl(person.avatarUrl)}
+          colorSeed={person.id}
+          name={label}
+          shape="circle"
+          size="sm"
+        />
+        <StyledPersonName>{label}</StyledPersonName>
+      </StyledPersonInfo>
+      <StyledCreatedAt>
+        {t`Created ${beautifyPastDateRelativeToNow(person.createdAt)}`}
+      </StyledCreatedAt>
+    </ActivityRow>
+  );
+};
+
+export const MyWorkRecentPeople = () => {
+  const { t } = useLingui();
+
+  const { records: people, loading } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+  });
+
+  if (loading && people.length === 0) {
+    return (
+      <Section.Root>
+        <Section.Header title={t`Recently added people`} />
+        <SkeletonLoader />
+      </Section.Root>
+    );
+  }
+
+  if (people.length === 0) {
+    return null;
+  }
+
+  return (
+    <Section.Root>
+      <Section.Header title={t`Recently added people`} />
+      <ActivityList>
+        {people.map((person, index) => (
+          <MyWorkPersonRow
+            key={person.id}
+            person={person}
+            divider={index < people.length - 1}
+          />
+        ))}
+      </ActivityList>
+    </Section.Root>
+  );
+};
