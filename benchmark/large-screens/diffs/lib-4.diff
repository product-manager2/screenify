+import { NavigationDrawerItem } from '@/ui/navigation/navigation-drawer/components/NavigationDrawerItem';
+import { NavigationDrawerSection } from '@/ui/navigation/navigation-drawer/components/NavigationDrawerSection';
+import { useLingui } from '@lingui/react/macro';
+import { useMatch } from 'react-router-dom';
+import { AppPath } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { IconCheckbox } from 'twenty-ui/icon';
+
+export const MyWorkNavigationDrawerItem = () => {
+  const { t } = useLingui();
+  const isMyWorkPageOpen = isDefined(useMatch(AppPath.MyWork));
+
+  return (
+    <NavigationDrawerSection>
+      <NavigationDrawerItem
+        label={t`My work`}
+        to={AppPath.MyWork}
+        Icon={IconCheckbox}
+        active={isMyWorkPageOpen}
+      />
+    </NavigationDrawerSection>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasks.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasks.tsx
new file mode 100644
index 00000000..e64306e0
--- /dev/null
+++ b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasks.tsx
@@ -0,0 +1,163 @@
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { SkeletonLoader } from '@/activities/components/SkeletonLoader';
+import { useCompleteTask } from '@/activities/tasks/hooks/useCompleteTask';
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { AnimatedPlaceholder } from '@/ui/feedback/empty-state/components/AnimatedPlaceholder/AnimatedPlaceholder';
+import { EmptyState } from '@/ui/feedback/empty-state/components/EmptyState';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { Callout } from 'twenty-ui/components/feedback';
+import { IconCalendar } from 'twenty-ui/icon';
+import { Checkbox } from 'twenty-ui/primitives/input';
+import { Card } from 'twenty-ui/primitives/surfaces';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+
+const StyledLeftSideContainer = styled.div`
+  align-items: center;
+  display: flex;
+  flex: 1;
+  overflow: hidden;
+`;
+
+const StyledCheckboxContainer = styled.div`
+  display: flex;
+`;
+
+const StyledTaskTitle = styled.div`
+  color: ${themeCssVariables.font.color.primary};
+  font-weight: ${themeCssVariables.font.weight.medium};
+  overflow: hidden;
+  padding: 0 ${themeCssVariables.spacing[2]};
+  text-overflow: ellipsis;
+  white-space: nowrap;
+`;
+
+const StyledDueDate = styled.div<{ isPast: boolean }>`
+  align-items: center;
+  color: ${({ isPast }) =>
+    isPast
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.secondary};
+  display: flex;
+  gap: ${themeCssVariables.spacing[1]};
+  padding-left: ${themeCssVariables.spacing[1]};
+  white-space: nowrap;
+`;
+
+type MyWorkTaskRowProps = {
+  task: Task;
+  divider: boolean;
+};
+
+const MyWorkTaskRow = ({ task, divider }: MyWorkTaskRowProps) => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+  const { completeTask } = useCompleteTask(task);
+
+  const title = isNonEmptyString(task.title) ? task.title : t`Task title`;
+
+  return (
+    <ActivityRow
+      label={title}
+      divider={divider}
+      onClick={() => {
+        openRecordInSidePanel({
+          recordId: task.id,
+          objectNameSingular: StandardObjectNameSingular.Task,
+        });
+      }}
+    >
+      <StyledLeftSideContainer>
+        <Card.Control
+          render={<StyledCheckboxContainer />}
+          onClick={(event) => event.stopPropagation()}
+        >
+          <Checkbox
+            checked={task.status === 'DONE'}
+            shape="round"
+            onCheckedChange={completeTask}
+          />
+        </Card.Control>
+        <StyledTaskTitle>{title}</StyledTaskTitle>
+      </StyledLeftSideContainer>
+      {isDefined(task.dueAt) && (
+        <StyledDueDate
+          isPast={hasDatePassed(task.dueAt) && task.status === 'TODO'}
+        >
+          <IconCalendar size={theme.icon.size.md} />
+          {beautifyExactDate(task.dueAt)}
+        </StyledDueDate>
+      )}
+    </ActivityRow>
+  );
+};
+
+export const MyWorkOpenTasks = () => {
+  const { t } = useLingui();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+
+  const {
+    records: tasks,
+    loading,
+    error,
+  } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: {
+      assigneeId: { eq: currentWorkspaceMember?.id },
+      or: [{ status: { is: 'NULL' } }, { status: { neq: 'DONE' } }],
+    },
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    skip: !isDefined(currentWorkspaceMember),
+  });
+
+  const renderContent = () => {
+    if (isDefined(error)) {
+      return <Callout status="error" title={t`Could not load your tasks.`} />;
+    }
+
+    if (loading && tasks.length === 0) {
+      return <SkeletonLoader />;
+    }
+
+    if (tasks.length === 0) {
+      return (
+        <EmptyState.Root>
+          <AnimatedPlaceholder type="noTask" />
+          <EmptyState.Content>
+            <EmptyState.Title>{t`You have no open tasks`}</EmptyState.Title>
+          </EmptyState.Content>
+        </EmptyState.Root>
+      );
+    }
+
+    return (
+      <ActivityList>
+        {tasks.map((task, index) => (
+          <MyWorkTaskRow
+            key={task.id}
+            task={task}
+            divider={index < tasks.length - 1}
+          />
+        ))}
+      </ActivityList>
+    );
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header title={t`Open tasks`} />
+      {renderContent()}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeople.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeople.tsx
