@@ -0,0 +1,24 @@
+import { formatNumber } from '@/localization/utils/formatNumber';
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import { useAggregateRecords } from '@/object-record/hooks/useAggregateRecords';
+import { AggregateOperations } from '@/object-record/record-table/constants/AggregateOperations';
+import { isDefined } from 'twenty-shared/utils';
+
+type SettingsWorkspaceUsageCountCellProps = {
+  item: EnrichedObjectMetadataItem;
+};
+
+export const SettingsWorkspaceUsageCountCell = ({
+  item,
+}: SettingsWorkspaceUsageCountCellProps) => {
+  const { data } = useAggregateRecords<{ id: { COUNT: number } }>({
+    objectNameSingular: item.nameSingular,
+    recordGqlFieldsAggregate: {
+      id: [AggregateOperations.COUNT],
+    },
+  });
+
+  const count = data.id?.COUNT;
+
+  return isDefined(count) ? formatNumber(count) : null;
+};
