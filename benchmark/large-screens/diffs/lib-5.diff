+import { IconCheckbox } from 'twenty-ui/icon';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+import { useIsMobile } from 'twenty-ui/utilities';
+
+const MY_WORK_SCROLL_WRAPPER_ID = 'my-work-page';
+
+const StyledContent = styled.div`
+  box-sizing: border-box;
+  display: flex;
+  flex-direction: column;
+  gap: ${themeCssVariables.spacing[8]};
+  padding: ${themeCssVariables.spacing[6]} ${themeCssVariables.spacing[6]} 0;
+  width: 100%;
+`;
+
+const StyledMobileNavigationBarClearance = styled.div`
+  flex-shrink: 0;
+  height: ${MOBILE_NAVIGATION_BAR_CLEARANCE};
+`;
+
+export const MyWorkPage = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const isMobile = useIsMobile();
+
+  const scrollWrapperComponentInstanceId =
+    useWorkspaceSurfaceScopedComponentInstanceId(MY_WORK_SCROLL_WRAPPER_ID);
+
+  return (
+    <>
+      <PageTitle title={t`My work`} />
+      <PageCardLayout
+        header={
+          <PageCardHeader
+            icon={<IconCheckbox size={theme.icon.size.md} />}
+            title={t`My work`}
+          />
+        }
+      >
+        <ScrollWrapper componentInstanceId={scrollWrapperComponentInstanceId}>
+          <StyledContent>
+            <MyWorkOpenTasksSection />
+            <MyWorkRecentPeopleSection />
+            {isMobile && <StyledMobileNavigationBarClearance />}
+          </StyledContent>
+        </ScrollWrapper>
+      </PageCardLayout>
+    </>
+  );
+};
