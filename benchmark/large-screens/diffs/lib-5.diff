@@ -0,0 +1,78 @@
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { RecordChip } from '@/object-record/components/RecordChip';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { DateDisplay } from '@/ui/field/display/components/DateDisplay';
+import { Table } from '@/ui/layout/table/components/Table';
+import { TableCell } from '@/ui/layout/table/components/TableCell';
+import { TableHeader } from '@/ui/layout/table/components/TableHeader';
+import { TableRow } from '@/ui/layout/table/components/TableRow';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { useLingui } from '@lingui/react/macro';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { Loader } from 'twenty-ui/primitives/feedback';
+import { themeCssVariables } from 'twenty-ui/theme';
+
+const HEADER_PADDING = `0 ${themeCssVariables.spacing[2]}`;
+
+const TABLE_GRID_AUTO_COLUMNS = '1fr auto';
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: {
+      and: [
+        { assigneeId: { eq: currentWorkspaceMember?.id ?? '' } },
+        { status: { neq: 'DONE' } },
+      ],
+    },
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    skip: !isDefined(currentWorkspaceMember),
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that are not done.`}
+      />
+      {loading ? (
+        <Loader />
+      ) : (
+        <Table>
+          <TableRow gridAutoColumns={TABLE_GRID_AUTO_COLUMNS}>
+            <TableHeader padding={HEADER_PADDING}>{t`Task`}</TableHeader>
+            <TableHeader padding={HEADER_PADDING}>{t`Due`}</TableHeader>
+          </TableRow>
+          {tasks.map((task) => (
+            <TableRow key={task.id} gridAutoColumns={TABLE_GRID_AUTO_COLUMNS}>
+              <TableCell>
+                <RecordChip
+                  objectNameSingular={StandardObjectNameSingular.Task}
+                  record={task}
+                />
+              </TableCell>
+              <TableCell color={themeCssVariables.font.color.secondary}>
+                <DateDisplay value={task.dueAt} />
+              </TableCell>
+            </TableRow>
+          ))}
+          {tasks.length === 0 && (
+            <TableRow gridAutoColumns={TABLE_GRID_AUTO_COLUMNS}>
+              <TableCell color={themeCssVariables.font.color.tertiary}>
+                {t`No open tasks`}
+              </TableCell>
+              <TableCell />
+            </TableRow>
+          )}
+        </Table>
+      )}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx
