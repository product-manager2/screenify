+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { useObjectMetadataItem } from '@/object-metadata/hooks/useObjectMetadataItem';
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import {
+  SettingsTableListSection,
+  type SettingsTableListSectionColumn,
+} from '@/settings/components/SettingsTableListSection';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { SettingsWorkspaceUsageCountCell } from '@/settings/workspace-usage/components/SettingsWorkspaceUsageCountCell';
+import { SettingsWorkspaceUsageObjectCell } from '@/settings/workspace-usage/components/SettingsWorkspaceUsageObjectCell';
+import { Trans, useLingui } from '@lingui/react/macro';
+import { SettingsPath, StandardObjectNameSingular } from 'twenty-shared/types';
+import { getSettingsPath } from 'twenty-shared/utils';
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+
+  const { activeNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+
+  const { objectMetadataItem: workspaceMemberObjectMetadataItem } =
+    useObjectMetadataItem({
+      objectNameSingular: StandardObjectNameSingular.WorkspaceMember,
+    });
+
+  const columns: SettingsTableListSectionColumn<EnrichedObjectMetadataItem>[] =
+    [
+      { label: t`Object`, Cell: SettingsWorkspaceUsageObjectCell },
+      {
+        label: t`Count`,
+        align: 'right',
+        Cell: SettingsWorkspaceUsageCountCell,
+      },
+    ];
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: <Trans>Workspace</Trans>,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: <Trans>Usage</Trans> },
+      ]}
+    >
+      <SettingsPageContainer>
+        <SettingsTableListSection
+          title={t`Members`}
+          description={t`People with access to this workspace.`}
+          items={[workspaceMemberObjectMetadataItem]}
+          columns={columns}
+          gridAutoColumns="1fr auto"
+        />
+        <SettingsTableListSection
+          title={t`Records`}
