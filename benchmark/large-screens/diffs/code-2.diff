+import { Trans, useLingui } from '@lingui/react/macro';
+import { SettingsPath } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconUsers } from 'twenty-ui/icon';
+import { Card } from 'twenty-ui/primitives/surfaces';
+import { Text } from 'twenty-ui/primitives/typography';
+
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { StandardObjectNamePlural } from '@/object-metadata/types/StandardObjectNamePlural';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { SettingsListItemCardContent } from '@/settings/components/SettingsListItemCardContent';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { SettingsWorkspaceUsageRecordsSection } from '@/settings/usage/components/SettingsWorkspaceUsageRecordsSection';
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const { formatNumber } = useNumberFormat();
+  const { alphaSortedActiveNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+
+  const isLoading =
+    Object.keys(totalCountByObjectMetadataItemNamePlural).length === 0;
+
+  const membersCount =
+    totalCountByObjectMetadataItemNamePlural[
+      StandardObjectNamePlural.WorkspaceMember
+    ];
+
+  const recordRows = alphaSortedActiveNonSystemObjectMetadataItems.map(
+    (objectMetadataItem) => ({
+      id: objectMetadataItem.id,
+      objectMetadataItem,
+      totalCount:
+        totalCountByObjectMetadataItemNamePlural[objectMetadataItem.namePlural],
+    }),
+  );
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: <Trans>Workspace</Trans>,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: <Trans>Usage</Trans> },
+      ]}
+    >
+      <SettingsPageContainer>
+        <Section.Root>
+          <Card.Root>
+            <SettingsListItemCardContent
+              LeftIcon={IconUsers}
+              label={t`Members`}
+              rightComponent={
+                isDefined(membersCount) ? (
+                  <Text color="secondary">{formatNumber(membersCount)}</Text>
+                ) : null
+              }
+            />
+          </Card.Root>
+        </Section.Root>
+        <SettingsWorkspaceUsageRecordsSection
+          rows={recordRows}
+          isLoading={isLoading}
+        />
+      </SettingsPageContainer>
+    </SettingsPageLayout>
+  );
+};
