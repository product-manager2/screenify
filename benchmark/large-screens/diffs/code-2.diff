+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isDefined } from 'twenty-shared/utils';
+import {
+  OverflowingTextWithTooltip,
+  Text,
+} from 'twenty-ui/primitives/typography';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { ObjectMetadataIcon } from '@/object-metadata/components/ObjectMetadataIcon';
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import {
+  SettingsTableListSection,
+  type SettingsTableListSectionColumn,
+} from '@/settings/components/SettingsTableListSection';
+
+export type SettingsWorkspaceUsageRecordRow = {
+  id: string;
+  objectMetadataItem: EnrichedObjectMetadataItem;
+  totalCount: number | undefined;
+};
+
+type SettingsWorkspaceUsageColumn =
+  SettingsTableListSectionColumn<SettingsWorkspaceUsageRecordRow>;
+
+const StyledObjectCell = styled.div`
+  align-items: center;
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+const SettingsWorkspaceUsageObjectCell = ({
+  item,
+}: {
+  item: SettingsWorkspaceUsageRecordRow;
+}) => {
+  const theme = useTheme();
+
+  return (
+    <StyledObjectCell>
+      <ObjectMetadataIcon
+        objectMetadataItem={item.objectMetadataItem}
+        size={theme.icon.size.md}
+        stroke={theme.icon.stroke.sm}
+      />
+      <OverflowingTextWithTooltip text={item.objectMetadataItem.labelPlural} />
+    </StyledObjectCell>
+  );
+};
+
+const SettingsWorkspaceUsageCountCell = ({
+  item,
+}: {
+  item: SettingsWorkspaceUsageRecordRow;
+}) => {
+  const { formatNumber } = useNumberFormat();
+
+  if (!isDefined(item.totalCount)) {
+    return null;
+  }
+
+  return <Text color="secondary">{formatNumber(item.totalCount)}</Text>;
+};
+
+type SettingsWorkspaceUsageRecordsSectionProps = {
+  rows: SettingsWorkspaceUsageRecordRow[];
+  isLoading: boolean;
+};
+
+export const SettingsWorkspaceUsageRecordsSection = ({
+  rows,
+  isLoading,
+}: SettingsWorkspaceUsageRecordsSectionProps) => {
+  const { t } = useLingui();
+
+  const columns: SettingsWorkspaceUsageColumn[] = [
+    { label: t`Object`, Cell: SettingsWorkspaceUsageObjectCell },
+    {
+      label: t`Records`,
+      align: 'right',
+      Cell: SettingsWorkspaceUsageCountCell,
+    },
+  ];
+
+  return (
+    <SettingsTableListSection
+      title={t`Records`}
+      description={t`Records stored in each object of this workspace`}
+      items={rows}
+      columns={columns}
+      gridAutoColumns="1fr 120px"
+      isLoading={isLoading}
+    />
+  );
+};
