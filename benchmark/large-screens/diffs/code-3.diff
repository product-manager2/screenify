index 00000000..54bd1f50
--- /dev/null
+++ b/packages/twenty-front/src/pages/my-work/MyWorkOpenTasksSection.tsx
@@ -0,0 +1,94 @@
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconCheckbox } from 'twenty-ui/icon';
+import { Button } from 'twenty-ui/primitives/input';
+import { ListItem } from 'twenty-ui/primitives/navigation';
+import { Text } from 'twenty-ui/primitives/typography';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+
+const StyledEmptyState = styled.div`
+  padding: ${themeCssVariables.spacing[2]};
+`;
+
+const StyledOverdueDate = styled(Text)`
+  color: ${themeCssVariables.font.color.danger};
+`;
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+  const currentWorkspaceMemberId = currentWorkspaceMember?.id;
+
+  const {
+    records: tasks,
+    loading,
+    hasNextPage,
+    fetchMoreRecords,
+  } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    skip: !isDefined(currentWorkspaceMemberId),
+    filter: isDefined(currentWorkspaceMemberId)
+      ? {
+          assigneeId: { eq: currentWorkspaceMemberId },
+          status: { neq: 'DONE' },
+        }
+      : undefined,
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header title={t`Open tasks`} />
+      {tasks.map((task) => (
+        <ListItem
+          key={task.id}
+          startIcon={<IconCheckbox size={theme.icon.size.md} />}
+          descriptionPlacement="end"
+          description={
+            isDefined(task.dueAt) ? (
+              hasDatePassed(task.dueAt) ? (
+                <StyledOverdueDate size="sm">
+                  {beautifyExactDate(task.dueAt)}
+                </StyledOverdueDate>
+              ) : (
+                <Text size="sm" color="secondary">
+                  {beautifyExactDate(task.dueAt)}
+                </Text>
+              )
+            ) : undefined
+          }
+          onClick={() =>
+            openRecordInSidePanel({
+              recordId: task.id,
+              objectNameSingular: StandardObjectNameSingular.Task,
+            })
+          }
+        >
+          {isNonEmptyString(task.title) ? task.title : t`Task title`}
+        </ListItem>
+      ))}
+      {!loading && tasks.length === 0 && (
+        <StyledEmptyState>
+          <Text color="tertiary">{t`No open tasks`}</Text>
+        </StyledEmptyState>
+      )}
+      {hasNextPage && (
+        <Button variant="outline" onClick={() => fetchMoreRecords()}>
+          {t`Load more`}
+        </Button>
+      )}
+    </Section.Root>
+  );
+};
