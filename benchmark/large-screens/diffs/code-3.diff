+import { PageCardHeader } from '@/ui/layout/page/components/PageCardHeader';
+import { PageCardLayout } from '@/ui/layout/page/components/PageCardLayout';
+import { PageTitle } from '@/ui/utilities/page-title/components/PageTitle';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { IconBriefcase } from 'twenty-ui/icon';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+import { MyWorkOpenTasksSection } from '~/pages/my-work/MyWorkOpenTasksSection';
+import { MyWorkRecentPeopleSection } from '~/pages/my-work/MyWorkRecentPeopleSection';
+
+const StyledContent = styled.div`
+  box-sizing: border-box;
+  display: flex;
+  flex: 1;
+  flex-direction: column;
+  gap: ${themeCssVariables.spacing[8]};
+  min-height: 0;
+  overflow: auto;
+  padding: ${themeCssVariables.spacing[4]};
+`;
+
+export const MyWorkPage = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+
+  return (
+    <>
+      <PageTitle title={t`My work`} />
+      <PageCardLayout
+        header={
+          <PageCardHeader
+            icon={<IconBriefcase size={theme.icon.size.md} />}
+            title={t`My work`}
+          />
+        }
+      >
+        <StyledContent>
+          <MyWorkOpenTasksSection />
+          <MyWorkRecentPeopleSection />
+        </StyledContent>
+      </PageCardLayout>
+    </>
+  );
+};
diff --git a/packages/twenty-front/src/pages/my-work/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/pages/my-work/MyWorkRecentPeopleSection.tsx
new file mode 100644
index 00000000..aed96d81
--- /dev/null
+++ b/packages/twenty-front/src/pages/my-work/MyWorkRecentPeopleSection.tsx
@@ -0,0 +1,74 @@
+import { type Person } from '@/people/types/Person';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+import { getAbsoluteImageUrl } from '~/utils/image/getAbsoluteImageUrl';
+import { useLingui } from '@lingui/react/macro';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { Section } from 'twenty-ui/components/layout';
+import { Avatar } from 'twenty-ui/primitives/data-display';
+import { ListItem } from 'twenty-ui/primitives/navigation';
+import { Text } from 'twenty-ui/primitives/typography';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { styled } from '@linaria/react';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+const StyledEmptyState = styled.div`
+  padding: ${themeCssVariables.spacing[2]};
+`;
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+
+  const { records: people, loading } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header title={t`Recently added people`} />
+      {people.map((person) => {
+        const personName =
+          `${person.name.firstName} ${person.name.lastName}`.trim();
+
+        return (
+          <ListItem
+            key={person.id}
+            startIcon={
+              <Avatar
+                src={getAbsoluteImageUrl(person.avatarUrl)}
+                colorSeed={person.id}
+                name={personName}
+                shape="circle"
+                size="sm"
+              />
+            }
+            descriptionPlacement="end"
+            description={
+              <Text size="sm" color="tertiary">
+                {t`Created ${beautifyPastDateRelativeToNow(person.createdAt)}`}
+              </Text>
+            }
+            onClick={() =>
+              openRecordInSidePanel({
+                recordId: person.id,
+                objectNameSingular: StandardObjectNameSingular.Person,
+              })
+            }
+          >
+            {personName || t`Unnamed person`}
+          </ListItem>
+        );
+      })}
+      {!loading && people.length === 0 && (
+        <StyledEmptyState>
+          <Text color="tertiary">{t`No people yet`}</Text>
+        </StyledEmptyState>
+      )}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
new file mode 100644
index 00000000..93874479
--- /dev/null
+++ b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
@@ -0,0 +1,107 @@
+import { formatNumber } from '@/localization/utils/formatNumber';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { SettingsListCard } from '@/settings/components/SettingsListCard';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { Trans, useLingui } from '@lingui/react/macro';
+import { AppPath, SettingsPath } from 'twenty-shared/types';
+import { getAppPath, getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { type IconComponent, IconUsers } from 'twenty-ui/icon';
+import { useIcons } from 'twenty-ui/icon/provider';
+import { Text } from 'twenty-ui/primitives/typography';
+
+type SettingsWorkspaceUsageItem = {
+  id: string;
+  label: string;
+  Icon: IconComponent;
+  totalCount: number | undefined;
+  to: string;
+};
+
+type SettingsWorkspaceUsageCountProps = {
+  item: SettingsWorkspaceUsageItem;
+};
+
+const SettingsWorkspaceUsageCount = ({
+  item,
+}: SettingsWorkspaceUsageCountProps) => (
+  <Text color="tertiary">
+    {isDefined(item.totalCount)
+      ? formatNumber(item.totalCount, { abbreviate: true })
+      : ''}
+  </Text>
+);
+
+const getItemTo = (item: SettingsWorkspaceUsageItem) => item.to;
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const { getIcon } = useIcons();
+  const { alphaSortedActiveNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+
+  const memberItems: SettingsWorkspaceUsageItem[] = [
+    {
+      id: 'workspaceMembers',
+      label: t`Members`,
+      Icon: IconUsers,
+      totalCount: totalCountByObjectMetadataItemNamePlural.workspaceMembers,
+      to: getSettingsPath(SettingsPath.WorkspaceMembersPage),
+    },
+  ];
+
+  const recordItems: SettingsWorkspaceUsageItem[] =
+    alphaSortedActiveNonSystemObjectMetadataItems.map((objectMetadataItem) => ({
+      id: objectMetadataItem.id,
+      label: objectMetadataItem.labelPlural,
+      Icon: getIcon(objectMetadataItem.icon),
+      totalCount:
+        totalCountByObjectMetadataItemNamePlural[objectMetadataItem.namePlural],
+      to: getAppPath(AppPath.RecordIndexPage, {
+        objectNamePlural: objectMetadataItem.namePlural,
+      }),
+    }));
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: <Trans>Workspace</Trans>,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: <Trans>Usage</Trans> },
+      ]}
+    >
+      <SettingsPageContainer>
+        <Section.Root>
+          <Section.Header title={t`Members`} />
+          <SettingsListCard
+            items={memberItems}
+            getItemLabel={(item) => item.label}
+            RowIconFn={(item) => item.Icon}
+            RowRightComponent={SettingsWorkspaceUsageCount}
+            to={getItemTo}
+          />
+        </Section.Root>
+        <Section.Root>
+          <Section.Header
+            title={t`Records`}
+            description={t`Records in each active object`}
+          />
+          <SettingsListCard
+            items={recordItems}
+            getItemLabel={(item) => item.label}
+            RowIconFn={(item) => item.Icon}
+            RowRightComponent={SettingsWorkspaceUsageCount}
+            to={getItemTo}
+          />
+        </Section.Root>
+      </SettingsPageContainer>
+    </SettingsPageLayout>
+  );
+};
