+import { NavigationDrawerItem } from '@/ui/navigation/navigation-drawer/components/NavigationDrawerItem';
+import { NavigationDrawerSection } from '@/ui/navigation/navigation-drawer/components/NavigationDrawerSection';
+import { useLingui } from '@lingui/react/macro';
+import { useMatch } from 'react-router-dom';
+import { AppPath } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { IconBriefcase } from 'twenty-ui/icon';
+
+export const MainNavigationDrawerMyWorkItem = () => {
+  const { t } = useLingui();
+  const isMyWorkPageOpen = isDefined(useMatch(AppPath.MyWork));
+
+  return (
+    <NavigationDrawerSection>
+      <NavigationDrawerItem
+        label={t`My work`}
+        to={AppPath.MyWork}
+        Icon={IconBriefcase}
+        active={isMyWorkPageOpen}
+      />
+    </NavigationDrawerSection>
+  );
+};
diff --git a/packages/twenty-front/src/pages/my-work/MyWorkOpenTasksSection.tsx b/packages/twenty-front/src/pages/my-work/MyWorkOpenTasksSection.tsx
