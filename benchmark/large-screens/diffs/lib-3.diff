diff --git a/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
new file mode 100644
index 00000000..c5bb9bd4
--- /dev/null
+++ b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
@@ -0,0 +1,153 @@
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { useMemo } from 'react';
+import { SettingsPath } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconUsers } from 'twenty-ui/icon';
+import { OverflowingTextWithTooltip } from 'twenty-ui/primitives/typography';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { ObjectMetadataIcon } from '@/object-metadata/components/ObjectMetadataIcon';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import { StandardObjectNamePlural } from '@/object-metadata/types/StandardObjectNamePlural';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsTableCard } from '@/settings/components/SettingsTableCard';
+import {
+  SettingsTableListSection,
+  type SettingsTableListSectionColumn,
+} from '@/settings/components/SettingsTableListSection';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+
+const GRID_AUTO_COLUMNS = '1fr 120px';
+
+const StyledNameCell = styled.div`
+  align-items: center;
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+const StyledCount = styled.div`
+  color: ${themeCssVariables.font.color.primary};
+  text-align: right;
+`;
+
+type WorkspaceUsageObjectRow = {
+  id: string;
+  objectMetadataItem: EnrichedObjectMetadataItem;
+  totalCount: number | undefined;
+};
+
+const ObjectNameCell = ({ item }: { item: WorkspaceUsageObjectRow }) => {
+  const theme = useTheme();
+
+  return (
+    <StyledNameCell>
+      <ObjectMetadataIcon
+        objectMetadataItem={item.objectMetadataItem}
+        size={theme.icon.size.md}
+      />
+      <OverflowingTextWithTooltip text={item.objectMetadataItem.labelPlural} />
+    </StyledNameCell>
+  );
+};
+
+const RecordCountCell = ({ item }: { item: WorkspaceUsageObjectRow }) => {
+  const { formatNumber } = useNumberFormat();
+
+  return (
+    <StyledCount>
+      {isDefined(item.totalCount) ? formatNumber(item.totalCount) : ''}
+    </StyledCount>
+  );
+};
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const { activeNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+  const { formatNumber } = useNumberFormat();
+
+  const objectRows = useMemo<WorkspaceUsageObjectRow[]>(
+    () =>
+      activeNonSystemObjectMetadataItems
+        .map((objectMetadataItem) => ({
+          id: objectMetadataItem.id,
+          objectMetadataItem,
+          totalCount:
+            totalCountByObjectMetadataItemNamePlural[
+              objectMetadataItem.namePlural
+            ],
+        }))
+        .sort(
+          (a, b) =>
+            (b.totalCount ?? 0) - (a.totalCount ?? 0) ||
+            a.objectMetadataItem.labelPlural.localeCompare(
+              b.objectMetadataItem.labelPlural,
+            ),
+        ),
+    [
+      activeNonSystemObjectMetadataItems,
+      totalCountByObjectMetadataItemNamePlural,
+    ],
+  );
+
+  const membersCount =
+    totalCountByObjectMetadataItemNamePlural[
+      StandardObjectNamePlural.WorkspaceMember
+    ];
+
+  const recordColumns: SettingsTableListSectionColumn<WorkspaceUsageObjectRow>[] =
+    [
+      { label: t`Object`, Cell: ObjectNameCell },
+      { label: t`Records`, align: 'right', Cell: RecordCountCell },
+    ];
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: t`Workspace`,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: t`Usage` },
+      ]}
+    >
+      <SettingsPageContainer>
+        <SettingsTableListSection
+          title={t`Records`}
+          description={t`How many records each object holds`}
+          items={objectRows}
+          columns={recordColumns}
+          gridAutoColumns={GRID_AUTO_COLUMNS}
+        />
+        <Section.Root>
+          <Section.Header
+            title={t`Members`}
+            description={t`People with access to this workspace`}
+          />
+          <SettingsTableCard
+            items={[
+              {
+                Icon: IconUsers,
+                label: t`Members`,
+                value: isDefined(membersCount)
+                  ? formatNumber(membersCount)
+                  : '',
+              },
+            ]}
+            gridAutoColumns={GRID_AUTO_COLUMNS}
+            valueAlign="right"
+          />
+        </Section.Root>
+      </SettingsPageContainer>
+    </SettingsPageLayout>
+  );
+};
