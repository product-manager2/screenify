@@ -0,0 +1,105 @@
+import { type Task } from '@/activities/types/Task';
+import { ListItemIconContainer } from '@/ui/navigation/list-item/components/ListItemIconContainer';
+import { getLinkToShowPage } from '@/object-metadata/utils/getLinkToShowPage';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { useMemo } from 'react';
+import { Link } from 'react-router-dom';
+import { QUERY_MAX_RECORDS } from 'twenty-shared/constants';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isDefined, isNonEmptyArray } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconCheckbox } from 'twenty-ui/icon';
+import { Loader } from 'twenty-ui/primitives/feedback';
+import { ListItem } from 'twenty-ui/primitives/navigation';
+import { Card } from 'twenty-ui/primitives/surfaces';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+
+const StyledEmptyMessage = styled.div`
+  color: ${themeCssVariables.font.color.tertiary};
+  padding: ${themeCssVariables.spacing[2]} ${themeCssVariables.spacing[3]};
+`;
+
+const StyledDueDate = styled.span<{ $isOverdue: boolean }>`
+  color: ${({ $isOverdue }) =>
+    $isOverdue
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.tertiary};
+`;
+
+type MyWorkOpenTasksSectionProps = {
+  workspaceMemberId: string;
+};
+
+export const MyWorkOpenTasksSection = ({
+  workspaceMemberId,
+}: MyWorkOpenTasksSectionProps) => {
+  const { t } = useLingui();
+
+  const openTasksFilter = useMemo(
+    () => ({
+      assigneeId: { eq: workspaceMemberId },
+      status: { in: ['TODO', 'IN_PROGRESS'] },
+    }),
+    [workspaceMemberId],
+  );
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: openTasksFilter,
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    recordGqlFields: { id: true, title: true, dueAt: true },
+    limit: QUERY_MAX_RECORDS,
+  });
+
+  const renderContent = () => {
+    if (loading) {
+      return <Loader role="status" aria-label={t`Loading your tasks`} />;
+    }
+
+    if (!isNonEmptyArray(tasks)) {
+      return (
+        <StyledEmptyMessage>{t`You have no open tasks.`}</StyledEmptyMessage>
+      );
+    }
+
+    return tasks.map((task) => (
+      <ListItem
+        key={task.id}
+        render={
+          <Link
+            to={getLinkToShowPage(StandardObjectNameSingular.Task, task)}
+          />
+        }
+        startIcon={
+          <ListItemIconContainer>
+            <IconCheckbox />
+          </ListItemIconContainer>
+        }
+        description={
+          isDefined(task.dueAt) ? (
+            <StyledDueDate $isOverdue={hasDatePassed(task.dueAt)}>
+              {beautifyExactDate(task.dueAt)}
+            </StyledDueDate>
+          ) : undefined
+        }
+        descriptionPlacement="end"
+      >
+        {isNonEmptyString(task.title) ? task.title : t`Untitled task`}
+      </ListItem>
+    ));
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that aren't done`}
+      />
+      <Card.Root>{renderContent()}</Card.Root>
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx
