+import { useLingui } from '@lingui/react/macro';
+import { SettingsPath, StandardObjectNameSingular } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { Card } from 'twenty-ui/primitives/surfaces';
+
+import { SettingsListItemCardContent } from '@/settings/components/SettingsListItemCardContent';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+
+export const SettingsWorkspaceUsageMembersSection = () => {
+  const { t } = useLingui();
+  const { formatNumber } = useNumberFormat();
+
+  const { totalCount } = useFindManyRecords({
+    objectNameSingular: StandardObjectNameSingular.WorkspaceMember,
+    limit: 1,
+    recordGqlFields: { id: true },
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Members`}
+        description={t`People who have access to this workspace`}
+      />
+      <Card.Root>
+        <SettingsListItemCardContent
+          label={t`Total`}
+          to={getSettingsPath(SettingsPath.WorkspaceMembersPage)}
+          rightComponent={
+            isDefined(totalCount) ? formatNumber(totalCount) : null
+          }
+        />
+      </Card.Root>
+    </Section.Root>
+  );
+};
