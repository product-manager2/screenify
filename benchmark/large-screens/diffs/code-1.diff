+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isDefined } from 'twenty-shared/utils';
+import { useIcons } from 'twenty-ui/icon/provider';
+import { useTheme, themeCssVariables } from 'twenty-ui/theme';
+
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { SettingsTableListSection } from '@/settings/components/SettingsTableListSection';
+
+const StyledObjectName = styled.div`
+  align-items: center;
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+type SettingsWorkspaceUsageCellProps = {
+  item: EnrichedObjectMetadataItem;
+};
+
+const SettingsWorkspaceUsageObjectNameCell = ({
+  item,
+}: SettingsWorkspaceUsageCellProps) => {
+  const theme = useTheme();
+  const { getIcon } = useIcons();
+  const Icon = getIcon(item.icon);
+
+  return (
+    <StyledObjectName>
+      <Icon size={theme.icon.size.sm} stroke={theme.icon.stroke.sm} />
+      {item.labelPlural}
+    </StyledObjectName>
+  );
+};
+
+const SettingsWorkspaceUsageRecordCountCell = ({
+  item,
+}: SettingsWorkspaceUsageCellProps) => {
+  const { formatNumber } = useNumberFormat();
+
+  const { totalCount } = useFindManyRecords({
+    objectNameSingular: item.nameSingular,
+    limit: 1,
+    recordGqlFields: { id: true },
+  });
+
+  return isDefined(totalCount)
+    ? formatNumber(totalCount, { abbreviate: true })
+    : null;
+};
+
+export const SettingsWorkspaceUsageRecordsSection = () => {
+  const { t } = useLingui();
+  const { alphaSortedActiveNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+
+  return (
+    <SettingsTableListSection
+      title={t`Records`}
+      description={t`Number of records in each object, including custom objects`}
+      items={alphaSortedActiveNonSystemObjectMetadataItems}
+      columns={[
+        {
+          label: t`Object`,
+          Cell: SettingsWorkspaceUsageObjectNameCell,
+        },
+        {
+          label: t`Records`,
+          align: 'right',
+          Cell: SettingsWorkspaceUsageRecordCountCell,
+        },
+      ]}
+      gridAutoColumns="minmax(0, 1fr) 96px"
+    />
+  );
+};
