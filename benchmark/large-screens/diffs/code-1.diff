+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { Section } from 'twenty-ui/components/layout';
+import { Text } from 'twenty-ui/primitives/typography';
+import { themeCssVariables } from 'twenty-ui/theme';
+
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { RecordChip } from '@/object-record/components/RecordChip';
+import { type Person } from '@/people/types/Person';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+const StyledPersonChip = styled.div`
+  flex: 1;
+  min-width: 0;
+`;
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+
+  const { records: recentPeople } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+    recordGqlFields: {
+      id: true,
+      name: true,
+      avatarUrl: true,
+      createdAt: true,
+    },
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Recently added people`}
+        description={t`The five people most recently added to the workspace`}
+      />
+      <ActivityList>
+        {recentPeople.map((person, index) => (
+          <ActivityRow
+            key={person.id}
+            label={`${person.name.firstName} ${person.name.lastName}`.trim()}
+            divider={index < recentPeople.length - 1}
+          >
+            <StyledPersonChip>
+              <RecordChip
+                objectNameSingular={StandardObjectNameSingular.Person}
+                record={person}
+                isBold
+              />
+            </StyledPersonChip>
+            <Text color="tertiary" size="sm">
+              {t`Created ${beautifyPastDateRelativeToNow(person.createdAt)}`}
+            </Text>
+          </ActivityRow>
+        ))}
+      </ActivityList>
+    </Section.Root>
+  );
+};
