diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx
new file mode 100644
index 00000000..2db4c172
--- /dev/null
+++ b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx
@@ -0,0 +1,125 @@
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconCalendar } from 'twenty-ui/icon';
+import {
+  OverflowingTextWithTooltip,
+  Text,
+} from 'twenty-ui/primitives/typography';
+import { Loader } from 'twenty-ui/primitives/feedback';
+import { useTheme, themeCssVariables } from 'twenty-ui/theme';
+
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+
+const OPEN_TASKS_LIMIT = 200;
+
+const StyledTaskTitle = styled.div`
+  flex: 1;
+  min-width: 0;
+`;
+
+const StyledDueDate = styled.div<{ isPast: boolean }>`
+  align-items: center;
+  color: ${({ isPast }) =>
+    isPast
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.secondary};
+  display: flex;
+  flex-shrink: 0;
+  gap: ${themeCssVariables.spacing[1]};
+  white-space: nowrap;
+`;
+
+const StyledLoaderContainer = styled.div`
+  display: flex;
+  justify-content: center;
+  padding: ${themeCssVariables.spacing[4]} 0;
+`;
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+
+  const { records: openTasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: {
+      assigneeId: { eq: currentWorkspaceMember?.id },
+      status: { neq: 'DONE' },
+    },
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    limit: OPEN_TASKS_LIMIT,
+    skip: !isDefined(currentWorkspaceMember),
+  });
+
+  const renderContent = () => {
+    if (loading && openTasks.length === 0) {
+      return (
+        <StyledLoaderContainer>
+          <Loader />
+        </StyledLoaderContainer>
+      );
+    }
+
+    if (openTasks.length === 0) {
+      return <Text color="tertiary">{t`You have no open tasks.`}</Text>;
+    }
+
+    return (
+      <ActivityList>
+        {openTasks.map((task, index) => {
+          const title = isNonEmptyString(task.title)
+            ? task.title
+            : t`Task title`;
+
+          return (
+            <ActivityRow
+              key={task.id}
+              label={title}
+              divider={index < openTasks.length - 1}
+              onClick={() =>
+                openRecordInSidePanel({
+                  recordId: task.id,
+                  objectNameSingular: StandardObjectNameSingular.Task,
+                })
+              }
+            >
+              <StyledTaskTitle>
+                <OverflowingTextWithTooltip text={title} />
+              </StyledTaskTitle>
+              {isDefined(task.dueAt) && (
+                <StyledDueDate
+                  isPast={hasDatePassed(task.dueAt) && task.status === 'TODO'}
+                >
+                  <IconCalendar size={theme.icon.size.sm} />
+                  {beautifyExactDate(task.dueAt)}
+                </StyledDueDate>
+              )}
+            </ActivityRow>
+          );
+        })}
+      </ActivityList>
+    );
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that aren't done`}
+      />
+      {renderContent()}
+    </Section.Root>
+  );
+};
