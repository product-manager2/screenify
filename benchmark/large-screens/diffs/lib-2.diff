@@ -0,0 +1,93 @@
+import { type Person } from '@/people/types/Person';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { SkeletonLine } from '@/ui/feedback/skeleton/components/SkeletonLine';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { isNonEmptyArray } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { ListItemButton } from 'twenty-ui/components/navigation';
+import { Avatar } from 'twenty-ui/primitives/data-display';
+import { SKELETON_HEIGHT_SIZES } from 'twenty-ui/primitives/feedback';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { getAbsoluteImageUrl } from '~/utils/image/getAbsoluteImageUrl';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+const StyledList = styled.div`
+  display: flex;
+  flex-direction: column;
+`;
+
+const StyledEmptyText = styled.div`
+  color: ${themeCssVariables.font.color.tertiary};
+`;
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+
+  const { records: people, loading } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+  });
+
+  const renderContent = () => {
+    if (loading) {
+      return <SkeletonLine count={3} height={SKELETON_HEIGHT_SIZES.l} />;
+    }
+
+    if (!isNonEmptyArray(people)) {
+      return <StyledEmptyText>{t`No people yet.`}</StyledEmptyText>;
+    }
+
+    return (
+      <StyledList>
+        {people.map((person) => {
+          const fullName = [person.name.firstName, person.name.lastName]
+            .filter(isNonEmptyString)
+            .join(' ');
+
+          return (
+            <ListItemButton
+              key={person.id}
+              startIcon={
+                <Avatar
+                  src={getAbsoluteImageUrl(person.avatarUrl)}
+                  colorSeed={person.id}
+                  name={fullName}
+                  shape="circle"
+                  size="sm"
+                />
+              }
+              description={t`Created ${beautifyPastDateRelativeToNow(person.createdAt)}`}
+              descriptionPlacement="end"
+              onClick={() =>
+                openRecordInSidePanel({
+                  recordId: person.id,
+                  objectNameSingular: StandardObjectNameSingular.Person,
+                })
+              }
+            >
+              {fullName}
+            </ListItemButton>
+          );
+        })}
+      </StyledList>
+    );
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Recently added people`}
+        description={t`The five people added to this workspace most recently`}
+      />
+      {renderContent()}
+    </Section.Root>
+  );
+};
