@@ -0,0 +1,139 @@
+import { ObjectMetadataIcon } from '@/object-metadata/components/ObjectMetadataIcon';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { type EnrichedObjectMetadataItem } from '@/object-metadata/types/EnrichedObjectMetadataItem';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { SettingsListItemCardContent } from '@/settings/components/SettingsListItemCardContent';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { SettingsTableListSection } from '@/settings/components/SettingsTableListSection';
+import { type WorkspaceMember } from '@/workspace-member/types/WorkspaceMember';
+import { styled } from '@linaria/react';
+import { Trans, useLingui } from '@lingui/react/macro';
+import { useMemo } from 'react';
+import { SettingsPath, StandardObjectNameSingular } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconUsers } from 'twenty-ui/icon';
+import { Card } from 'twenty-ui/primitives/surfaces';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+
+type WorkspaceUsageObjectItem = {
+  id: string;
+  objectMetadataItem: EnrichedObjectMetadataItem;
+  recordCount: number | undefined;
+};
+
+const StyledObjectCell = styled.div`
+  align-items: center;
+  color: ${themeCssVariables.font.color.primary};
+  display: flex;
+  gap: ${themeCssVariables.spacing[2]};
+  min-width: 0;
+`;
+
+const StyledObjectName = styled.span`
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+`;
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { formatNumber } = useNumberFormat();
+  const { alphaSortedActiveNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+
+  const { totalCount: memberCount } = useFindManyRecords<WorkspaceMember>({
+    objectNameSingular: StandardObjectNameSingular.WorkspaceMember,
+    limit: 1,
+  });
+
+  const objectUsageItems = useMemo<WorkspaceUsageObjectItem[]>(
+    () =>
+      alphaSortedActiveNonSystemObjectMetadataItems.map(
+        (objectMetadataItem) => ({
+          id: objectMetadataItem.id,
+          objectMetadataItem,
+          recordCount:
+            totalCountByObjectMetadataItemNamePlural[
+              objectMetadataItem.namePlural
+            ],
+        }),
+      ),
+    [
+      alphaSortedActiveNonSystemObjectMetadataItems,
+      totalCountByObjectMetadataItemNamePlural,
+    ],
+  );
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: <Trans>Workspace</Trans>,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: <Trans>Usage</Trans> },
+      ]}
+    >
+      <SettingsPageContainer>
+        <Section.Root>
+          <Section.Header
+            title={t`Members`}
+            description={t`People who can access this workspace`}
+          />
+          <Card.Root>
+            <SettingsListItemCardContent
+              LeftIcon={IconUsers}
+              label={t`Total`}
+              rightComponent={
+                isDefined(memberCount) ? formatNumber(memberCount) : null
+              }
+              to={getSettingsPath(SettingsPath.WorkspaceMembersPage)}
+            />
+          </Card.Root>
+        </Section.Root>
+        <SettingsTableListSection<WorkspaceUsageObjectItem>
+          title={t`Records`}
+          description={t`Records in each object, including custom objects`}
+          items={objectUsageItems}
+          columns={[
+            {
+              label: t`Object`,
+              Cell: ({ item }) => (
+                <StyledObjectCell>
+                  <ObjectMetadataIcon
+                    objectMetadataItem={item.objectMetadataItem}
+                    size={theme.icon.size.md}
+                    stroke={theme.icon.stroke.sm}
+                  />
+                  <StyledObjectName>
+                    {item.objectMetadataItem.labelPlural}
+                  </StyledObjectName>
+                </StyledObjectCell>
+              ),
+            },
+            {
+              label: t`Records`,
+              align: 'right',
+              Cell: ({ item }) => (
+                <>
+                  {isDefined(item.recordCount)
+                    ? formatNumber(item.recordCount)
+                    : null}
+                </>
+              ),
+            },
+          ]}
+          gridAutoColumns="1fr 120px"
+        />
+      </SettingsPageContainer>
+    </SettingsPageLayout>
+  );
+};
