+    ${themeCssVariables.spacing[20]};
+  width: 100%;
+
+  @media (max-width: ${MOBILE_VIEWPORT}px) {
+    padding: ${themeCssVariables.spacing[4]} ${themeCssVariables.spacing[4]}
+      ${themeCssVariables.spacing[20]};
+  }
+`;
+
+export const MyWorkPage = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+
+  return (
+    <>
+      <PageTitle title={t`My work`} />
+      <PageCardLayout
+        header={
+          <PageCardHeader
+            icon={<IconListCheck size={theme.icon.size.md} />}
+            title={t`My work`}
+          />
+        }
+      >
+        <ScrollWrapper componentInstanceId={MY_WORK_SCROLL_WRAPPER_INSTANCE_ID}>
+          <StyledContent>
+            <MyWorkOpenTasksSection />
+            <MyWorkRecentPeopleSection />
+          </StyledContent>
+        </ScrollWrapper>
+      </PageCardLayout>
+    </>
+  );
+};
diff --git a/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx b/packages/twenty-front/src/pages/settings/usage/SettingsWorkspaceUsage.tsx
