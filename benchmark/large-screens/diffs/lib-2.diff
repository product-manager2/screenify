diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx
new file mode 100644
index 00000000..55f729a2
--- /dev/null
+++ b/packages/twenty-front/src/modules/my-work/components/MyWorkOpenTasksSection.tsx
@@ -0,0 +1,110 @@
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { type Task } from '@/activities/types/Task';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { SkeletonLine } from '@/ui/feedback/skeleton/components/SkeletonLine';
+import { styled } from '@linaria/react';
+import { useLingui } from '@lingui/react/macro';
+import { isNonEmptyString } from '@sniptt/guards';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+import { isDefined, isNonEmptyArray } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { ListItemButton } from 'twenty-ui/components/navigation';
+import { IconCheckbox } from 'twenty-ui/icon';
+import { SKELETON_HEIGHT_SIZES } from 'twenty-ui/primitives/feedback';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+
+const MY_WORK_TASKS_LIMIT = 200;
+
+const StyledList = styled.div`
+  display: flex;
+  flex-direction: column;
+`;
+
+const StyledDueDate = styled.span<{ isOverdue: boolean }>`
+  color: ${({ isOverdue }) =>
+    isOverdue
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.tertiary};
+  white-space: nowrap;
+`;
+
+const StyledEmptyText = styled.div`
+  color: ${themeCssVariables.font.color.tertiary};
+`;
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: {
+      assigneeId: { eq: currentWorkspaceMember?.id },
+      status: { in: ['TODO', 'IN_PROGRESS'] },
+    },
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    limit: MY_WORK_TASKS_LIMIT,
+    skip: !isDefined(currentWorkspaceMember),
+  });
+
+  const renderContent = () => {
+    if (loading) {
+      return <SkeletonLine count={3} height={SKELETON_HEIGHT_SIZES.l} />;
+    }
+
+    if (!isNonEmptyArray(tasks)) {
+      return <StyledEmptyText>{t`You have no open tasks.`}</StyledEmptyText>;
+    }
+
+    return (
+      <StyledList>
+        {tasks.map((task) => (
+          <ListItemButton
+            key={task.id}
+            startIcon={
+              <IconCheckbox
+                size={theme.icon.size.md}
+                stroke={theme.icon.stroke.sm}
+              />
+            }
+            description={
+              isDefined(task.dueAt) ? (
+                <StyledDueDate isOverdue={hasDatePassed(task.dueAt)}>
+                  {beautifyExactDate(task.dueAt)}
+                </StyledDueDate>
+              ) : (
+                <StyledDueDate isOverdue={false}>
+                  {t`No due date`}
+                </StyledDueDate>
+              )
+            }
+            descriptionPlacement="end"
+            onClick={() =>
+              openRecordInSidePanel({
+                recordId: task.id,
+                objectNameSingular: StandardObjectNameSingular.Task,
+              })
+            }
+          >
+            {isNonEmptyString(task.title) ? task.title : t`Task title`}
+          </ListItemButton>
+        ))}
+      </StyledList>
+    );
+  };
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that are not done`}
+      />
+      {renderContent()}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx
