@@ -0,0 +1,96 @@
+import { styled } from '@linaria/react';
+
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { dateLocaleState } from '@/localization/states/dateLocaleState';
+import { type Person } from '@/people/types/Person';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { RecordChip } from '@/object-record/components/RecordChip';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { useLingui } from '@lingui/react/macro';
+import { StandardObjectNameSingular } from 'twenty-shared/types';
+import { Section } from 'twenty-ui/components/layout';
+import { Loader } from 'twenty-ui/primitives/feedback';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+const StyledAddedDate = styled.div`
+  color: ${themeCssVariables.font.color.tertiary};
+  margin-left: auto;
+  padding-left: ${themeCssVariables.spacing[2]};
+  white-space: nowrap;
+`;
+
+const StyledEmptyRow = styled.div`
+  align-items: center;
+  color: ${themeCssVariables.font.color.tertiary};
+  display: flex;
+  height: ${themeCssVariables.spacing[12]};
+  padding: 0 ${themeCssVariables.spacing[4]};
+`;
+
+type MyWorkPersonRowProps = {
+  person: Person;
+  divider: boolean;
+};
+
+const MyWorkPersonRow = ({ person, divider }: MyWorkPersonRowProps) => {
+  const { t } = useLingui();
+  const dateLocale = useAtomStateValue(dateLocaleState);
+
+  const addedAgo = beautifyPastDateRelativeToNow(
+    person.createdAt,
+    dateLocale.localeCatalog,
+  );
+
+  return (
+    <ActivityRow
+      label={`${person.name.firstName} ${person.name.lastName}`.trim()}
+      divider={divider}
+    >
+      <RecordChip
+        objectNameSingular={StandardObjectNameSingular.Person}
+        record={person}
+      />
+      <StyledAddedDate>{t`Added ${addedAgo}`}</StyledAddedDate>
+    </ActivityRow>
+  );
+};
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+
+  const { records: people, loading } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Recently added people`}
+        description={t`The five people most recently added to the workspace`}
+      />
+      {loading && people.length === 0 ? (
+        <Loader />
+      ) : people.length === 0 ? (
+        <ActivityList>
+          <StyledEmptyRow>{t`No people yet.`}</StyledEmptyRow>
+        </ActivityList>
+      ) : (
+        <ActivityList>
+          {people.map((person, index) => (
+            <MyWorkPersonRow
+              key={person.id}
+              person={person}
+              divider={index < people.length - 1}
+            />
+          ))}
+        </ActivityList>
+      )}
+    </Section.Root>
+  );
+};
