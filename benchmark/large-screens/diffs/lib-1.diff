@@ -0,0 +1,146 @@
+import { styled } from '@linaria/react';
+import { useContext } from 'react';
+
+import { ActivityList } from '@/activities/components/ActivityList';
+import { ActivityRow } from '@/activities/components/ActivityRow';
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { dateLocaleState } from '@/localization/states/dateLocaleState';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { formatDateString } from '@/object-record/record-field/ui/utils/formatDateString';
+import { useOpenRecordInSidePanel } from '@/side-panel/hooks/useOpenRecordInSidePanel';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { UserContext } from '@/users/contexts/UserContext';
+import { useLingui } from '@lingui/react/macro';
+import {
+  type RecordGqlOperationFilter,
+  StandardObjectNameSingular,
+} from 'twenty-shared/types';
+import { isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { Loader } from 'twenty-ui/primitives/feedback';
+import { themeCssVariables } from 'twenty-ui/theme';
+import { hasDatePassed } from '~/utils/date-utils';
+
+const OPEN_TASK_STATUSES = ['TODO', 'IN_PROGRESS'];
+
+const StyledTaskTitle = styled.div`
+  color: ${themeCssVariables.font.color.primary};
+  font-weight: ${themeCssVariables.font.weight.medium};
+  min-width: 0;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+`;
+
+const StyledDueDate = styled.div<{ isPast: boolean }>`
+  color: ${({ isPast }) =>
+    isPast
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.tertiary};
+  margin-left: auto;
+  padding-left: ${themeCssVariables.spacing[2]};
+  white-space: nowrap;
+`;
+
+const StyledEmptyRow = styled.div`
+  align-items: center;
+  color: ${themeCssVariables.font.color.tertiary};
+  display: flex;
+  height: ${themeCssVariables.spacing[12]};
+  padding: 0 ${themeCssVariables.spacing[4]};
+`;
+
+const buildOpenTasksFilter = (
+  workspaceMemberId: string,
+): RecordGqlOperationFilter => ({
+  and: [
+    { assignee: { id: { eq: workspaceMemberId } } },
+    {
+      or: [
+        { status: { is: 'NULL' } },
+        { status: { in: OPEN_TASK_STATUSES } },
+      ],
+    },
+  ],
+});
+
+type MyWorkTaskRowProps = {
+  task: Task;
+  divider: boolean;
+};
+
+const MyWorkTaskRow = ({ task, divider }: MyWorkTaskRowProps) => {
+  const { t } = useLingui();
+  const { openRecordInSidePanel } = useOpenRecordInSidePanel();
+  const { dateFormat, timeZone } = useContext(UserContext);
+  const dateLocale = useAtomStateValue(dateLocaleState);
+
+  const title = task.title || t`Task title`;
+
+  return (
+    <ActivityRow
+      label={title}
+      divider={divider}
+      onClick={() =>
+        openRecordInSidePanel({
+          recordId: task.id,
+          objectNameSingular: StandardObjectNameSingular.Task,
+        })
+      }
+    >
+      <StyledTaskTitle>{title}</StyledTaskTitle>
+      {isDefined(task.dueAt) && (
+        <StyledDueDate isPast={hasDatePassed(task.dueAt)}>
+          {formatDateString({
+            value: task.dueAt,
+            timeZone,
+            dateFormat,
+            localeCatalog: dateLocale.localeCatalog,
+          })}
+        </StyledDueDate>
+      )}
+    </ActivityRow>
+  );
+};
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+  const currentWorkspaceMemberId = currentWorkspaceMember?.id;
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    filter: isDefined(currentWorkspaceMemberId)
+      ? buildOpenTasksFilter(currentWorkspaceMemberId)
+      : undefined,
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    skip: !isDefined(currentWorkspaceMemberId),
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that are not done`}
+      />
+      {loading && tasks.length === 0 ? (
+        <Loader />
+      ) : tasks.length === 0 ? (
+        <ActivityList>
+          <StyledEmptyRow>{t`You have no open tasks.`}</StyledEmptyRow>
+        </ActivityList>
+      ) : (
+        <ActivityList>
+          {tasks.map((task, index) => (
+            <MyWorkTaskRow
+              key={task.id}
+              task={task}
+              divider={index < tasks.length - 1}
+            />
+          ))}
+        </ActivityList>
+      )}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx
