@@ -0,0 +1,104 @@
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { useFilteredObjectMetadataItems } from '@/object-metadata/hooks/useFilteredObjectMetadataItems';
+import { StandardObjectNamePlural } from '@/object-metadata/types/StandardObjectNamePlural';
+import { useCombinedGetTotalCount } from '@/object-record/multiple-objects/hooks/useCombinedGetTotalCount';
+import { SettingsPageContainer } from '@/settings/components/SettingsPageContainer';
+import { SettingsTableCard } from '@/settings/components/SettingsTableCard';
+import { SettingsTableListSection } from '@/settings/components/SettingsTableListSection';
+import { SettingsPageLayout } from '@/settings/components/layout/SettingsPageLayout';
+import { SettingsWorkspaceUsageObjectNameCell } from '@/settings/workspace-usage/components/SettingsWorkspaceUsageObjectNameCell';
+import { SettingsWorkspaceUsageRecordCountCell } from '@/settings/workspace-usage/components/SettingsWorkspaceUsageRecordCountCell';
+import {
+  type SettingsWorkspaceUsageObjectColumn,
+  type SettingsWorkspaceUsageObjectItem,
+} from '@/settings/workspace-usage/types/SettingsWorkspaceUsageObjectItem';
+import { useLingui } from '@lingui/react/macro';
+import { useMemo } from 'react';
+import { SettingsPath } from 'twenty-shared/types';
+import { getSettingsPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+
+export const SettingsWorkspaceUsage = () => {
+  const { t } = useLingui();
+  const { formatNumber } = useNumberFormat();
+  const { alphaSortedActiveNonSystemObjectMetadataItems } =
+    useFilteredObjectMetadataItems();
+  const { totalCountByObjectMetadataItemNamePlural } =
+    useCombinedGetTotalCount();
+
+  const objectItems: SettingsWorkspaceUsageObjectItem[] = useMemo(
+    () =>
+      alphaSortedActiveNonSystemObjectMetadataItems.map(
+        (objectMetadataItem) => ({
+          id: objectMetadataItem.id,
+          objectMetadataItem,
+          totalCount:
+            totalCountByObjectMetadataItemNamePlural[
+              objectMetadataItem.namePlural
+            ],
+        }),
+      ),
+    [
+      alphaSortedActiveNonSystemObjectMetadataItems,
+      totalCountByObjectMetadataItemNamePlural,
+    ],
+  );
+
+  const objectColumns: SettingsWorkspaceUsageObjectColumn[] = [
+    {
+      label: t`Object`,
+      Cell: SettingsWorkspaceUsageObjectNameCell,
+    },
+    {
+      label: t`Records`,
+      align: 'right',
+      Cell: SettingsWorkspaceUsageRecordCountCell,
+    },
+  ];
+
+  const membersCount =
+    totalCountByObjectMetadataItemNamePlural[
+      StandardObjectNamePlural.WorkspaceMember
+    ];
+
+  return (
+    <SettingsPageLayout
+      title={t`Usage`}
+      links={[
+        {
+          children: t`Workspace`,
+          href: getSettingsPath(SettingsPath.General),
+        },
+        { children: t`Usage` },
+      ]}
+    >
+      <SettingsPageContainer>
+        <SettingsTableListSection
+          title={t`Records`}
+          description={t`How many records each object holds, including custom objects.`}
+          items={objectItems}
+          columns={objectColumns}
+          gridAutoColumns="1fr 160px"
+        />
+        <Section.Root>
+          <Section.Header
+            title={t`Members`}
+            description={t`Members who can sign in to this workspace.`}
+          />
+          <SettingsTableCard
+            items={[
+              {
+                label: t`Total`,
+                value: isDefined(membersCount)
+                  ? formatNumber(membersCount)
+                  : '',
+              },
+            ]}
+            gridAutoColumns="1fr 160px"
+            valueAlign="right"
+          />
+        </Section.Root>
+      </SettingsPageContainer>
+    </SettingsPageLayout>
+  );
+};
