@@ -0,0 +1,86 @@
+import { type Person } from '@/people/types/Person';
+import { SettingsSectionSkeletonLoader } from '@/settings/components/SettingsSectionSkeletonLoader';
+import { EmptyState } from '@/ui/feedback/empty-state/components/EmptyState';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { isNonEmptyString } from '@sniptt/guards';
+import { useLingui } from '@lingui/react/macro';
+import { Link } from 'react-router-dom';
+import { AppPath, StandardObjectNameSingular } from 'twenty-shared/types';
+import { getAppPath } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { Avatar } from 'twenty-ui/primitives/data-display';
+import { ListItem } from 'twenty-ui/primitives/navigation';
+import { beautifyPastDateRelativeToNow } from '~/utils/date-utils';
+
+const RECENT_PEOPLE_LIMIT = 5;
+
+export const MyWorkRecentPeopleSection = () => {
+  const { t } = useLingui();
+
+  const { records: people, loading } = useFindManyRecords<Person>({
+    objectNameSingular: StandardObjectNameSingular.Person,
+    orderBy: [{ createdAt: 'DescNullsLast' }],
+    limit: RECENT_PEOPLE_LIMIT,
+    recordGqlFields: {
+      id: true,
+      name: true,
+      avatarUrl: true,
+      createdAt: true,
+    },
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Recently added people`}
+        description={t`The five people most recently added to this workspace.`}
+      />
+      {loading && people.length === 0 ? (
+        <SettingsSectionSkeletonLoader rowCount={3} />
+      ) : people.length === 0 ? (
+        <EmptyState.Root>
+          <EmptyState.Content>
+            <EmptyState.Title>{t`No people yet`}</EmptyState.Title>
+            <EmptyState.Description>
+              {t`People added to this workspace will appear here.`}
+            </EmptyState.Description>
+          </EmptyState.Content>
+        </EmptyState.Root>
+      ) : (
+        people.map((person) => {
+          const fullName =
+            [person.name.firstName, person.name.lastName]
+              .filter(isNonEmptyString)
+              .join(' ') || t`No name`;
+
+          return (
+            <ListItem
+              key={person.id}
+              render={
+                <Link
+                  to={getAppPath(AppPath.RecordShowPage, {
+                    objectNameSingular: StandardObjectNameSingular.Person,
+                    objectRecordId: person.id,
+                  })}
+                />
+              }
+              startIcon={
+                <Avatar
+                  src={person.avatarUrl}
+                  name={fullName}
+                  colorSeed={person.id}
+                  shape="circle"
+                  size="md"
+                />
+              }
+              description={t`Added ${beautifyPastDateRelativeToNow(person.createdAt)}`}
+              descriptionPlacement="end"
+            >
+              {fullName}
+            </ListItem>
+          );
+        })
+      )}
+    </Section.Root>
+  );
+};
