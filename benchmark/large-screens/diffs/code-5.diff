@@ -0,0 +1,110 @@
+import { type Task } from '@/activities/types/Task';
+import { currentWorkspaceMemberState } from '@/auth/states/currentWorkspaceMemberState';
+import { SettingsSectionSkeletonLoader } from '@/settings/components/SettingsSectionSkeletonLoader';
+import { EmptyState } from '@/ui/feedback/empty-state/components/EmptyState';
+import { useAtomStateValue } from '@/ui/utilities/state/jotai/hooks/useAtomStateValue';
+import { useFindManyRecords } from '@/object-record/hooks/useFindManyRecords';
+import { styled } from '@linaria/react';
+import { isNonEmptyString } from '@sniptt/guards';
+import { useLingui } from '@lingui/react/macro';
+import { Link } from 'react-router-dom';
+import { AppPath, StandardObjectNameSingular } from 'twenty-shared/types';
+import { getAppPath, isDefined } from 'twenty-shared/utils';
+import { Section } from 'twenty-ui/components/layout';
+import { IconCalendar, IconCheckbox } from 'twenty-ui/icon';
+import { ListItem } from 'twenty-ui/primitives/navigation';
+import { themeCssVariables, useTheme } from 'twenty-ui/theme';
+import { beautifyExactDate, hasDatePassed } from '~/utils/date-utils';
+
+const StyledDueDate = styled.span<{ $isOverdue: boolean }>`
+  align-items: center;
+  color: ${({ $isOverdue }) =>
+    $isOverdue
+      ? themeCssVariables.font.color.danger
+      : themeCssVariables.font.color.tertiary};
+  display: flex;
+  gap: ${themeCssVariables.spacing[1]};
+  white-space: nowrap;
+`;
+
+export const MyWorkOpenTasksSection = () => {
+  const { t } = useLingui();
+  const theme = useTheme();
+  const currentWorkspaceMember = useAtomStateValue(currentWorkspaceMemberState);
+  const currentWorkspaceMemberId = currentWorkspaceMember?.id;
+
+  const { records: tasks, loading } = useFindManyRecords<Task>({
+    objectNameSingular: StandardObjectNameSingular.Task,
+    skip: !isDefined(currentWorkspaceMemberId),
+    filter: {
+      and: [
+        { assigneeId: { eq: currentWorkspaceMemberId ?? '' } },
+        {
+          or: [
+            { status: { in: ['TODO', 'IN_PROGRESS'] } },
+            { status: { is: 'NULL' } },
+          ],
+        },
+      ],
+    },
+    orderBy: [{ dueAt: 'AscNullsLast' }],
+    recordGqlFields: { id: true, title: true, dueAt: true, status: true },
+  });
+
+  return (
+    <Section.Root>
+      <Section.Header
+        title={t`Open tasks`}
+        description={t`Tasks assigned to you that are not done, by due date.`}
+      />
+      {loading && tasks.length === 0 ? (
+        <SettingsSectionSkeletonLoader rowCount={3} />
+      ) : tasks.length === 0 ? (
+        <EmptyState.Root>
+          <EmptyState.Content>
+            <EmptyState.Title>{t`No open tasks`}</EmptyState.Title>
+            <EmptyState.Description>
+              {t`Tasks assigned to you that are not done will appear here.`}
+            </EmptyState.Description>
+          </EmptyState.Content>
+        </EmptyState.Root>
+      ) : (
+        tasks.map((task) => {
+          const isOverdue =
+            isDefined(task.dueAt) && hasDatePassed(task.dueAt);
+
+          return (
+            <ListItem
+              key={task.id}
+              render={
+                <Link
+                  to={getAppPath(AppPath.RecordShowPage, {
+                    objectNameSingular: StandardObjectNameSingular.Task,
+                    objectRecordId: task.id,
+                  })}
+                />
+              }
+              startIcon={
+                <IconCheckbox
+                  size={theme.icon.size.md}
+                  stroke={theme.icon.stroke.sm}
+                />
+              }
+              description={
+                isDefined(task.dueAt) ? (
+                  <StyledDueDate $isOverdue={isOverdue}>
+                    <IconCalendar size={theme.icon.size.md} />
+                    {beautifyExactDate(task.dueAt)}
+                  </StyledDueDate>
+                ) : undefined
+              }
+              descriptionPlacement="end"
+            >
+              {isNonEmptyString(task.title) ? task.title : t`Task title`}
+            </ListItem>
+          );
+        })
+      )}
+    </Section.Root>
+  );
+};
diff --git a/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx b/packages/twenty-front/src/modules/my-work/components/MyWorkRecentPeopleSection.tsx
