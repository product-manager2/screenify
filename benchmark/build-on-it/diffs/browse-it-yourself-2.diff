new file mode 100644
index 0000000..a3c0ee8
--- /dev/null
+++ b/web/src/hooks/useCopyMemoContent.ts
@@ -0,0 +1,14 @@
+import copy from "copy-to-clipboard";
+import { useCallback } from "react";
+import toast from "react-hot-toast";
+import type { Memo } from "@/types/proto/api/memo_service_pb";
+import { useTranslate } from "@/utils/i18n";
+
+/** Returns a handler that copies the memo's Markdown text to the clipboard and confirms with a toast. */
+export const useCopyMemoContent = (memo: Pick<Memo, "content">) => {
+  const t = useTranslate();
+  return useCallback(() => {
+    copy(memo.content);
+    toast.success(t("message.succeed-copy-content"));
+  }, [memo.content, t]);
+};
