+import { renderHook } from '@testing-library/react';
+import { type ReactNode } from 'react';
+
+import { FieldContext } from '@/object-record/record-field/ui/contexts/FieldContext';
+import { useGetSecondaryFieldButton } from '@/object-record/record-field/ui/hooks/useGetSecondaryFieldButton';
+import { type FieldDefinition } from '@/object-record/record-field/ui/types/FieldDefinition';
+import {
+  type FieldAddressMetadata,
+  type FieldAddressValue,
+} from '@/object-record/record-field/ui/types/FieldMetadata';
+import { FieldMetadataType } from '~/generated-metadata/graphql';
+import { IconCopy } from 'twenty-ui/icon';
+
+const mockCopyToClipboard = jest.fn();
+let mockFieldValue: FieldAddressValue | undefined;
+
+jest.mock('~/hooks/useCopyToClipboard', () => ({
+  useCopyToClipboard: () => ({ copyToClipboard: mockCopyToClipboard }),
+}));
+
+jest.mock('@/object-record/record-store/hooks/useRecordFieldValue', () => ({
+  useRecordFieldValue: () => mockFieldValue,
+}));
+
+jest.mock('@/activities/emails/hooks/useOpenEmailInAppOrFallback', () => ({
+  useOpenEmailInAppOrFallback: () => ({ openEmail: jest.fn() }),
+}));
+
+const addressFieldDefinition: FieldDefinition<FieldAddressMetadata> = {
+  fieldMetadataId: 'addressFieldMetadataId',
+  label: 'Address',
+  iconName: 'IconMap',
+  type: FieldMetadataType.ADDRESS,
+  defaultValue: null,
+  metadata: {
+    fieldName: 'address',
+    placeHolder: 'Address',
+  },
+};
+
+const wrapper = ({ children }: { children: ReactNode }) => (
+  <FieldContext.Provider
+    value={{
+      fieldDefinition: addressFieldDefinition,
+      recordId: 'recordId',
+      isLabelIdentifier: false,
+      isRecordFieldReadOnly: false,
+    }}
+  >
+    {children}
+  </FieldContext.Provider>
+);
+
+describe('useGetSecondaryFieldButton', () => {
+  beforeEach(() => {
+    mockCopyToClipboard.mockClear();
+  });
+
+  it('should return a copy button for an address', () => {
+    mockFieldValue = {
+      addressStreet1: '888 Brannan St',
+      addressStreet2: null,
+      addressCity: 'San Francisco',
+      addressState: 'CA',
+      addressPostcode: '94107',
+      addressCountry: 'United States',
+      addressLat: null,
+      addressLng: null,
+    };
+
+    const { result } = renderHook(() => useGetSecondaryFieldButton(), {
+      wrapper,
+    });
+
+    expect(result.current).toHaveLength(1);
+    expect(result.current[0].Icon).toBe(IconCopy);
+  });
+
+  it('should copy the formatted address when the button is clicked', () => {
+    mockFieldValue = {
+      addressStreet1: '888 Brannan St',
+      addressStreet2: null,
+      addressCity: 'San Francisco',
+      addressState: 'CA',
+      addressPostcode: '94107',
+      addressCountry: 'United States',
+      addressLat: null,
+      addressLng: null,
+    };
+
+    const { result } = renderHook(() => useGetSecondaryFieldButton(), {
+      wrapper,
+    });
+
+    result.current[0].onClick();
+
+    expect(mockCopyToClipboard).toHaveBeenCalledWith(
+      '888 Brannan St, San Francisco, CA, 94107, United States',
+      expect.any(String),
+    );
+  });
+
+  it('should return no button when the address is empty', () => {
+    mockFieldValue = undefined;
+
+    const { result } = renderHook(() => useGetSecondaryFieldButton(), {
+      wrapper,
+    });
+
+    expect(result.current).toEqual([]);
+  });
+});
