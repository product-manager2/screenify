@@ -0,0 +1,21 @@
+import { useNumberFormat } from '@/localization/hooks/useNumberFormat';
+import { useGetRecordIndexTotalCount } from '@/views/hooks/internal/useGetRecordIndexTotalCount';
+import { styled } from '@linaria/react';
+import { isDefined } from 'twenty-shared/utils';
+import { themeCssVariables } from 'twenty-ui/theme';
+
+const StyledTotalCount = styled.span`
+  color: ${themeCssVariables.font.color.tertiary};
+  padding-left: ${themeCssVariables.spacing['0.5']};
+`;
+
+export const RecordIndexPageHeaderTotalCount = () => {
+  const { totalCount } = useGetRecordIndexTotalCount();
+  const { formatNumber } = useNumberFormat();
+
+  if (!isDefined(totalCount)) {
+    return null;
+  }
+
+  return <StyledTotalCount>{formatNumber(totalCount)}</StyledTotalCount>;
+};
